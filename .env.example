# 公開URL（OGP・ログイン後のリダイレクトに使う）
SITE_URL=http://localhost:3000

# 署名鍵（それぞれ32文字以上のランダム文字列。openssl rand -base64 32 で生成）
CLEAR_TOKEN_SECRET=
IMAGE_URL_SECRET=
SESSION_SECRET=

# 作者ログインのパスワード（12文字以上）
AUTHOR_PASSWORD=

# v1: PostgreSQL と画像の保存先
POSTGRES_PASSWORD=
DATABASE_URL=postgres://picross:picross@localhost:5432/picross
STORAGE_DIR=./storage
